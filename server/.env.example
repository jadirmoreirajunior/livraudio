# Azure Speech resource
AZURE_SPEECH_KEY=COLOQUE_SUA_CHAVE_AQUI
AZURE_SPEECH_REGION=brazilsouth

# Fallbacks documentados de vozes multilíngues pt-BR do Azure.
# Substitua pelos IDs do provedor que realmente disponibilizar Alessio/Isabella,
# caso você tenha acesso a eles.
VOICE_MALE=pt-BR-MacerioMultilingualNeural
VOICE_FEMALE=pt-BR-ThalitaMultilingualNeural
PORT=3000
